# ==============================================================================
# LLM & Embedding Provider Configuration (LiteLLM / OpenAI / Anthropic)
# ==============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Primary LLM for structured answer synthesis (supports LiteLLM model strings)
LLM_MODEL=gpt-4o-mini
# Fast LLM for the Query Rewriter / Optimizer step
QUERY_REWRITER_MODEL=gpt-4o-mini
# Dense embedding model (OpenAI text-embedding-3-small = 1536 dims)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ==============================================================================
# Qdrant Vector Database Configuration
# ==============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=document_intelligence_hybrid
QDRANT_API_KEY=

# ==============================================================================
# Hybrid Search, Chunking & Reranking Parameters
# ==============================================================================
SPARSE_MODEL_NAME=Qdrant/bm25
RERANKER_MODEL_NAME=ms-marco-MiniLM-L-12-v2

CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Number of candidates fetched per modality (Dense + Sparse) before RRF fusion
HYBRID_PREFETCH_LIMIT=20
# Number of fused candidates passed to Cross-Encoder Reranker
RRF_TOP_K=12
# Final top-K chunks after FlashRank reranking passed to the LLM
RERANK_TOP_K=5
# Minimum reranker relevance score (0.0 - 1.0) to include a chunk
RERANK_SCORE_THRESHOLD=0.20

# ==============================================================================
# Backend & Frontend Runtime Settings
# ==============================================================================
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
